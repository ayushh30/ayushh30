# Copy to .env (git-ignored) and fill in. NEVER commit real card details.

# Exact product page URL of the WHITE 0SG variant (open that variant on Flipkart, copy the URL)
PRODUCT_URL=https://www.flipkart.com/new-balance-530-sneakers-men/p/itm775a9863cb8e8?pid=SHOHPJKVC6GBRVHW&lid=LSTSHOHPJKVC6GBRVHWGYARZN&marketplace=FLIPKART
# The variant text that must appear on the page before we buy (safety check)
REQUIRE_TEXT=0SG
# Sizes in priority order
SIZES=8.5,9
# Max FINAL amount (INR) on the payment page: after card discount, incl. platform fee.
# Above this, or if the card discount is missing, the order is held open and you decide.
MAX_PRICE=4000

# Polling: base seconds between page reloads, plus random jitter (keep >= 3 to avoid blocks)
POLL_SECONDS=4
POLL_JITTER=2

# Card (ICICI credit card). Only used to fill the Flipkart payment form.
CARD_NUMBER=
CARD_EXPIRY_MM=
CARD_EXPIRY_YY=
CARD_CVV=
# Text to look for in the offers list so we know the ICICI offer is applied
OFFER_TEXT=ICICI

# true = go through checkout but STOP before clicking Pay. Set false to really buy.
DRY_RUN=true
HEADLESS=false
